# Copia este archivo como .env y rellénalo. NUNCA lo subas a git.
BYDFI_API_KEY=
BYDFI_API_SECRET=
# Mínimo 16 caracteres. El mismo valor va en "secret" del mensaje de la alerta.
WEBHOOK_SECRET=
SYMBOL=BTC/USDT:USDT
# Varios activos en un solo relay (tiene prioridad sobre SYMBOL). Cada alerta se envía
# al activo de su {{ticker}}: BTCUSDT.P -> BTC/USDT:USDT, etc.
# SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,SOL/USDT:USDT
# Tope por activo, en su moneda base (obligatorio con SYMBOLS):
# MAX_POSITION=BTC=0.01,ETH=0.3,SOL=5
LEVERAGE=1
MARGIN_MODE=isolated
# Tope de seguridad: tamaño máximo de la posición en la moneda base (BTC, o SOL si SYMBOL=SOL/USDT:USDT).
MAX_POSITION_BTC=0.01
# true para el scalper (btc_scalper.pine)
ALLOW_SHORT=false
# Déjalo en true hasta comprobar que las alertas llegan bien.
DRY_RUN=true
# Opcional: IPs de TradingView separadas por comas (compruébalas en la ayuda de TradingView).
ALLOWED_IPS=
PORT=8080
