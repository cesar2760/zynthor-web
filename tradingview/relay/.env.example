# Copia este archivo como .env y rellénalo. NUNCA lo subas a git.
BYDFI_API_KEY=
BYDFI_API_SECRET=
# Mínimo 16 caracteres. El mismo valor va en "secret" del mensaje de la alerta.
WEBHOOK_SECRET=
SYMBOL=BTC/USDT:USDT
LEVERAGE=1
MARGIN_MODE=isolated
# Tope de seguridad: tamaño máximo de la posición en BTC.
MAX_POSITION_BTC=0.01
ALLOW_SHORT=false
# Déjalo en true hasta comprobar que las alertas llegan bien.
DRY_RUN=true
# Opcional: IPs de TradingView separadas por comas (compruébalas en la ayuda de TradingView).
ALLOWED_IPS=
PORT=8080
