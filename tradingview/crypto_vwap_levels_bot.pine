// This Pine Script® code is subject to the terms of the Mozilla Public License 2.0
// https://mozilla.org/MPL/2.0/
//
// Crypto VWAP + Niveles Bot (Zynthor) - BTC, ETH y SOL en futuros BYDFi
// ------------------------------------------------------------------------------
// Versión automática (strategy) del indicador "Niveles del informe" para cripto:
//
//  · DOS VWAP: diario (amarillo, desde las 00:00 UTC o desde las 18:00 NY) y
//    Nueva York (azul, desde las 9:30 NY).
//  · Quién manda: arriba de los dos = compradores; abajo de los dos = vendedores;
//    entre los dos = el VWAP diario es el imán.
//  · Entrada 1 - retroceso al VWAP NY: toca el VWAP NY y cierra a favor, en horario NY.
//  · Entrada 2 - rebote / rechazo en niveles: barre el nivel y cierra al otro lado con
//    mecha grande (≥ 40 % de la vela). Si va contra el VWAP diario, medio tamaño.
//  · Niveles automáticos: máximo/mínimo del día y semana anteriores, rango de Asia,
//    pivotes confirmados, bandas ±1 del VWAP diario y los dos VWAP. Más niveles manuales
//    opcionales por activo (mismo formato que el indicador: precio|tipo|texto;...).
//  · Stop detrás de la mecha + 0.3 × ATR. TP1 = primer nivel contrario (cierra la mitad y
//    mueve el stop a la entrada). TP2 = el siguiente nivel. R:R mínimo 1.5 al TP1.
//  · Riesgo por operación, apalancamiento máximo, pérdida diaria y entradas por día.
//  · Cada orden envía el mensaje del relay de BYDFi (tradingview/relay) con SL y TP.
//
// AVISO: no es asesoría financiera. Prueba con DRY_RUN y luego con importes mínimos.
// ------------------------------------------------------------------------------
//@version=6
strategy("Crypto VWAP + Niveles Bot (Zynthor)", shorttitle = "VWAP Niveles Bot", overlay = true,
     max_lines_count         = 200,
     max_labels_count        = 200,
     max_bars_back           = 500,
     initial_capital         = 1000,
     default_qty_type        = strategy.percent_of_equity,
     default_qty_value       = 100,
     commission_type         = strategy.commission.percent,
     commission_value        = 0.018,
     slippage                = 2,
     pyramiding              = 0,
     margin_long             = 20,
     margin_short            = 20,
     calc_on_every_tick      = false,
     process_orders_on_close = false)

// ───────────────────────────── Inputs ─────────────────────────────
const string G_MAN  = "1) Niveles manuales (opcional) · precio|tipo|texto ; ...  (R, S, I)"
const string G_AUTO = "2) Niveles automáticos"
const string G_VW   = "3) VWAP diario y VWAP Nueva York"
const string G_ENT  = "4) Entradas"
const string G_EXIT = "5) Salidas"
const string G_RISK = "6) Riesgo"
const string G_VIS  = "7) Fechas y visual"
const string G_ALR  = "8) Mensaje de alerta (relay BYDFi)"

btcStr = input.text_area("", "Bitcoin (BTC)", group = G_MAN)
ethStr = input.text_area("", "Ethereum (ETH)", group = G_MAN)
solStr = input.text_area("", "Solana (SOL)", group = G_MAN)

usePD    = input.bool(true, "Máximo y mínimo del día anterior", group = G_AUTO)
usePW    = input.bool(true, "Máximo y mínimo de la semana anterior", group = G_AUTO)
useAsia  = input.bool(true, "Máximo y mínimo de la sesión de Asia (cuando termina)", group = G_AUTO)
asiaSess = input.session("0000-0800", "Sesión de Asia (UTC)", group = G_AUTO)
usePiv   = input.bool(true, "Pivotes confirmados (soportes y resistencias)", group = G_AUTO)
pivL     = input.int(10, "Pivote: velas a la izquierda", minval = 1, group = G_AUTO)
pivR     = input.int(5, "Pivote: velas a la derecha (confirmación)", minval = 1, group = G_AUTO)
maxPiv   = input.int(10, "Máximo de pivotes guardados", minval = 2, maxval = 40, group = G_AUTO)
mergeAtr = input.float(0.25, "Unir pivotes más cerca de ATR ×", minval = 0, step = 0.05, group = G_AUTO)
useBand  = input.bool(true, "Bandas ±1 del VWAP diario", group = G_AUTO)
bandMult = input.float(1.0, "Desviaciones de las bandas", minval = 0.1, step = 0.1, group = G_AUTO)

dAnchor  = input.string("00:00 UTC (cripto)", "Inicio del VWAP diario", options = ["00:00 UTC (cripto)", "18:00 Nueva York (como futuros)"], group = G_VW)
sigSess  = input.session("0935-1530", "Horario de entradas al VWAP NY (hora de Nueva York)", group = G_VW)
lvAllDay = input.bool(true, "Rebotes en niveles también fuera del horario NY", group = G_VW)
sigCool  = input.int(15, "Velas mínimas entre señales del VWAP NY", minval = 1, group = G_VW)

useVwapSig = input.bool(true, "Entrada: retroceso al VWAP NY a favor de quien manda", group = G_ENT)
useLvl     = input.bool(true, "Entrada: rebote / rechazo en niveles y VWAP", group = G_ENT)
lvWick     = input.float(40, "Mecha mínima del rechazo (% de la vela)", minval = 0, maxval = 90, group = G_ENT) / 100
lvCool     = input.int(12, "Velas de espera antes de repetir en el mismo nivel", minval = 1, group = G_ENT)
lvBias     = input.bool(false, "Rebotes solo a favor de quien manda", group = G_ENT)
halfContra = input.bool(true, "Contra el VWAP diario: medio tamaño", group = G_ENT)
allowLong  = input.bool(true, "Permitir compras", group = G_ENT)
allowShort = input.bool(true, "Permitir ventas", group = G_ENT)

lvBuf    = input.float(0.3, "Margen del stop detrás de la mecha (× ATR 14)", minval = 0, step = 0.05, group = G_EXIT)
minRR    = input.float(1.5, "R:R mínimo al TP1", minval = 0.5, step = 0.1, group = G_EXIT)
minTpPct = input.float(0.15, "TP1 mínimo (% del precio, para cubrir comisiones)", minval = 0, step = 0.01, group = G_EXIT)
tp1Pct   = input.float(50, "Cerrar en TP1 (% de la posición)", minval = 1, maxval = 100, group = G_EXIT)
beAfter  = input.bool(true, "Tras TP1, mover el stop a la entrada", group = G_EXIT)
maxBars  = input.int(0, "Salida por tiempo (velas, 0 = no)", minval = 0, group = G_EXIT)

riskPct    = input.float(0.5, "Riesgo por operación (% del capital)", minval = 0.05, maxval = 10, step = 0.05, group = G_RISK)
maxLev     = input.float(3.0, "Apalancamiento máximo (exposición / capital)", minval = 1, maxval = 5, step = 0.5, group = G_RISK)
maxDayLoss = input.float(3.0, "Pérdida máxima diaria (%)", minval = 0.1, maxval = 50, step = 0.1, group = G_RISK)
maxPerDay  = input.int(6, "Máximo de entradas por día", minval = 1, maxval = 50, group = G_RISK)
qtyDecOth  = input.int(2, "Decimales de la cantidad (otros activos)", minval = 0, maxval = 8, group = G_RISK)

startDate = input.time(timestamp("2024-01-01T00:00:00"), "Desde", group = G_VIS)
endDate   = input.time(timestamp("2099-12-31T00:00:00"), "Hasta", group = G_VIS)
showLv    = input.bool(true, "Dibujar niveles", group = G_VIS)
showLbl   = input.bool(true, "Etiquetas en las entradas", group = G_VIS)

relayMsg = input.text_area('{"secret":"CAMBIA_ESTE_SECRETO","symbol":"{{ticker}}","market_position":"{{strategy.market_position}}","position_size":"{{strategy.market_position_size}}","action":"{{strategy.order.action}}","contracts":"{{strategy.order.contracts}}","price":"{{close}}","order_id":"{{strategy.order.id}}","sl":"%SL%","tp":"%TP%"}', "Mensaje para todas las órdenes", group = G_ALR)

f_msg(float slP, float tpP) =>
    string m = str.replace_all(relayMsg, "%SL%", na(slP) ? "" : str.tostring(slP, format.mintick))
    str.replace_all(m, "%TP%", na(tpP) ? "" : str.tostring(tpP, format.mintick))

// ─────────────────────────── Activo ───────────────────────────
base   = syminfo.basecurrency
isBTC  = base == "BTC"
isETH  = base == "ETH"
isSOL  = base == "SOL"
manStr = isBTC ? btcStr : isETH ? ethStr : isSOL ? solStr : ""
qtyDec = isBTC ? 3 : isETH ? 2 : isSOL ? 1 : qtyDecOth
assetName = isBTC ? "BITCOIN" : isETH ? "ETHEREUM" : isSOL ? "SOLANA" : base

// ─────────────────── DOS VWAP: diario y Nueva York ───────────────────
nyHour  = hour(time, "America/New_York")
nyHour1 = hour(time[1], "America/New_York")
dChange = dAnchor == "00:00 UTC (cripto)" ? timeframe.change("D") : (nyHour >= 18 and nyHour1 < 18)
[vwapD, dUp, dDn] = ta.vwap(hlc3, dChange, bandMult)

nyRth  = not na(time(timeframe.period, "0930-1600", "America/New_York"))
nyOpen = nyRth and not nyRth[1]
var float npv = na
var float nvv = na
if dChange
    npv := na
    nvv := na
if nyOpen
    npv := hlc3 * volume
    nvv := volume
else if not na(npv)
    npv += hlc3 * volume
    nvv += volume
vwapNY = nvv > 0 ? npv / nvv : na

aboveBoth = not na(vwapNY) and close > vwapD and close > vwapNY
belowBoth = not na(vwapNY) and close < vwapD and close < vwapNY
magnetUp  = not na(vwapNY) and close > vwapNY and close < vwapD
magnetDn  = not na(vwapNY) and close < vwapNY and close > vwapD
inSig     = not na(time(timeframe.period, sigSess, "America/New_York"))

atrV = ta.atr(14)

// ─────────────────────────── Niveles ───────────────────────────
// Manuales: se leen una vez.
var array<float>  mLv  = array.new<float>()
var array<string> mTyp = array.new<string>()
var array<string> mTxt = array.new<string>()
if barstate.isfirst
    for it in str.split(str.replace_all(manStr, "\n", ";"), ";")
        pp = str.split(it, "|")
        if array.size(pp) >= 1
            v = str.tonumber(str.trim(array.get(pp, 0)))
            if not na(v)
                array.push(mLv, v)
                array.push(mTyp, array.size(pp) >= 2 ? str.trim(array.get(pp, 1)) : "")
                array.push(mTxt, array.size(pp) >= 3 ? str.trim(array.get(pp, 2)) : "Nivel")

// Día y semana anteriores (velas cerradas, sin repintado).
pdh = request.security(syminfo.tickerid, "D", high[1], lookahead = barmerge.lookahead_on)
pdl = request.security(syminfo.tickerid, "D", low[1], lookahead = barmerge.lookahead_on)
pwh = request.security(syminfo.tickerid, "W", high[1], lookahead = barmerge.lookahead_on)
pwl = request.security(syminfo.tickerid, "W", low[1], lookahead = barmerge.lookahead_on)

// Rango de Asia de hoy: solo cuenta cuando la sesión ya terminó.
inAsia = not na(time(timeframe.period, asiaSess, "UTC"))
var float asiaH = na
var float asiaL = na
var bool  asiaDone = false
if inAsia and not inAsia[1]
    asiaH := high
    asiaL := low
    asiaDone := false
else if inAsia
    asiaH := math.max(asiaH, high)
    asiaL := math.min(asiaL, low)
else if not na(asiaH)
    asiaDone := true

// Pivotes confirmados, unidos si están muy cerca.
var array<float> piv = array.new<float>()
f_addPiv(array<float> lv, float lvl, float z, int maxN) =>
    bool merged = false
    int n = array.size(lv)
    if n > 0
        for i = 0 to n - 1
            float cur = array.get(lv, i)
            if math.abs(cur - lvl) <= z
                array.set(lv, i, (cur + lvl) / 2)
                merged := true
                break
    if not merged
        array.push(lv, lvl)
        if array.size(lv) > maxN
            array.shift(lv)
    merged

ph = ta.pivothigh(high, pivL, pivR)
pl = ta.pivotlow(low, pivL, pivR)
if usePiv and not na(ph)
    f_addPiv(piv, ph, atrV * mergeAtr, maxPiv)
if usePiv and not na(pl)
    f_addPiv(piv, pl, atrV * mergeAtr, maxPiv)

// Lista de candidatos de esta vela (precio + nombre).
f_push(array<float> a, array<string> n, float v, string nm) =>
    if not na(v)
        array.push(a, v)
        array.push(n, nm)
    true

cand  = array.new<float>()
candN = array.new<string>()
if array.size(mLv) > 0
    for i = 0 to array.size(mLv) - 1
        f_push(cand, candN, array.get(mLv, i), array.get(mTxt, i))
if usePD
    f_push(cand, candN, pdh, "Máximo de ayer")
    f_push(cand, candN, pdl, "Mínimo de ayer")
if usePW
    f_push(cand, candN, pwh, "Máximo semana anterior")
    f_push(cand, candN, pwl, "Mínimo semana anterior")
if useAsia and asiaDone
    f_push(cand, candN, asiaH, "Máximo de Asia")
    f_push(cand, candN, asiaL, "Mínimo de Asia")
if array.size(piv) > 0
    for i = 0 to array.size(piv) - 1
        f_push(cand, candN, array.get(piv, i), "Pivote " + str.tostring(array.get(piv, i), format.mintick))
if useBand
    f_push(cand, candN, dUp, "Banda +1 VWAP")
    f_push(cand, candN, dDn, "Banda -1 VWAP")
f_push(cand, candN, vwapD, "VWAP diario")
f_push(cand, candN, vwapNY, "VWAP NY")

// Primer nivel más allá de un precio en una dirección.
f_target(array<float> a, float from, bool up, float gap) =>
    float best = na
    for x in a
        if (up ? x > from + gap : x < from - gap) and (na(best) or (up ? x < best : x > best))
            best := x
    best

// ─────────────────────────── Señales ───────────────────────────
inDate = time >= startDate and time <= endDate
rng = high - low

// Entrada 1: retroceso al VWAP NY con vela de confirmación.
vLongRaw  = useVwapSig and inSig and (aboveBoth or magnetUp) and low <= vwapNY and close > vwapNY and close > open
vShortRaw = useVwapSig and inSig and (belowBoth or magnetDn) and high >= vwapNY and close < vwapNY and close < open
var int lastVL = na
var int lastVS = na
vLong  = vLongRaw and (na(lastVL) or bar_index - lastVL > sigCool)
vShort = vShortRaw and (na(lastVS) or bar_index - lastVS > sigCool)

// Entrada 2: rebote / rechazo con mecha grande en el nivel más cercano.
var map<string, int> lastHit = map.new<string, int>()
float bX = na
string bN = ""
bool bBuy = false
float bDist = na
lvOk = useLvl and (lvAllDay or inSig) and rng > 0
if lvOk and array.size(cand) > 0
    for i = 0 to array.size(cand) - 1
        float x = array.get(cand, i)
        string nm = array.get(candN, i)
        int lastB = nz(map.get(lastHit, nm), -100000)
        if bar_index - lastB > lvCool
            bool bounce = low <= x and close > x and close > open and (math.min(open, close) - low) >= lvWick * rng and open >= x - rng
            bool reject = high >= x and close < x and close < open and (high - math.max(open, close)) >= lvWick * rng and open <= x + rng
            if (bounce or reject) and (na(bDist) or math.abs(close - x) < bDist)
                bX := x
                bN := nm
                bBuy := bounce
                bDist := math.abs(close - x)
lLong  = not na(bX) and bBuy and (not lvBias or aboveBoth or magnetUp)
lShort = not na(bX) and not bBuy and (not lvBias or belowBoth or magnetDn)

// ─────────────────────── Protecciones diarias ───────────────────────
var float dayStartEq = strategy.initial_capital
var int   entriesToday = 0
if timeframe.change("D")
    dayStartEq := strategy.equity
    entriesToday := 0
dayLossHit = strategy.equity <= dayStartEq * (1 - maxDayLoss / 100)
canEnter = inDate and not dayLossHit and entriesToday < maxPerDay and strategy.position_size == 0 and barstate.isconfirmed

// ───────────────────────── Tamaño de posición ─────────────────────────
f_qty(float risk, float mult) =>
    float maxQty  = strategy.equity * maxLev / (close * syminfo.pointvalue)
    float riskQty = risk > 0 ? strategy.equity * riskPct / 100 / (risk * syminfo.pointvalue) : maxQty
    float factor  = math.pow(10, qtyDec)
    math.floor(math.min(riskQty * mult, maxQty) * factor) / factor

// ───────────────────────────── Órdenes ─────────────────────────────
var float entP = na
var float slP  = na
var float tp1P = na
var float tp2P = na
var bool  tp1Done = false
var int   entryBar = na
var string lastTxt = "sin entradas todavía"

bool wantLong  = allowLong and (vLong or lLong)
bool wantShort = allowShort and (vShort or lShort) and not wantLong
string why = wantLong ? (lLong ? "REBOTE en " + bN : "Retroceso al VWAP NY") : wantShort ? (lShort ? "RECHAZO en " + bN : "Retroceso al VWAP NY") : ""

if canEnter and (wantLong or wantShort)
    bool b = wantLong
    float en = close
    float sl = b ? low - lvBuf * atrV : high + lvBuf * atrV
    float risk = math.abs(en - sl)
    float t1 = f_target(cand, en, b, 0.1 * risk)
    float t2 = na(t1) ? na : f_target(cand, t1, b, 0.1 * risk)
    if not na(t1) and na(t2)
        t2 := b ? t1 + (t1 - en) : t1 - (en - t1)
    bool rrOk = not na(t1) and math.abs(t1 - en) >= minRR * risk and math.abs(t1 - en) >= en * minTpPct / 100
    bool contra = halfContra and (b ? close < vwapD : close > vwapD)
    if rrOk
        float q = f_qty(risk, contra ? 0.5 : 1.0)
        if q > 0
            entP := en
            slP := sl
            tp1P := t1
            tp2P := t2
            tp1Done := false
            entryBar := bar_index
            entriesToday += 1
            if vLong or vShort
                if b
                    lastVL := bar_index
                else
                    lastVS := bar_index
            if lLong or lShort
                map.put(lastHit, bN, bar_index)
            string nm2 = (b ? "COMPRA" : "VENTA") + (contra ? " ½" : "")
            lastTxt := nm2 + " · " + why + " · SL " + str.tostring(sl, format.mintick) + " · TP1 " + str.tostring(t1, format.mintick)
            if b
                strategy.entry("Long", strategy.long, qty = q, alert_message = f_msg(slP, tp2P))
            else
                strategy.entry("Short", strategy.short, qty = q, alert_message = f_msg(slP, tp2P))
            if showLbl
                label.new(bar_index, b ? low : high, "✔ " + nm2 + "\n" + why + "\nSL " + str.tostring(sl, format.mintick) + " · TP1 " + str.tostring(t1, format.mintick) + (contra ? "\ncontra el VWAP diario: medio tamaño" : ""),
                     style = b ? label.style_label_up : label.style_label_down, color = b ? color.green : color.red, textcolor = color.white, size = size.small)
    else if showLbl and not na(bX) and (lLong or lShort)
        label.new(bar_index, b ? low : high, (b ? "rebote" : "rechazo") + " en " + bN + "\nsin R:R: el próximo nivel está muy cerca",
             style = b ? label.style_label_up : label.style_label_down, color = color.new(color.gray, 40), textcolor = color.white, size = size.tiny)

// Detectar TP1 ejecutado (la posición se redujo pero sigue abierta) y mover el stop a la entrada.
if strategy.position_size != 0 and not tp1Done and math.abs(strategy.position_size) < math.abs(strategy.position_size[1]) and math.sign(strategy.position_size) == math.sign(strategy.position_size[1])
    tp1Done := true
    if beAfter
        slP := strategy.position_avg_price
    if showLbl
        label.new(bar_index, strategy.position_size > 0 ? high : low, "TP1" + (beAfter ? "\nstop a la entrada" : ""),
             style = strategy.position_size > 0 ? label.style_label_down : label.style_label_up, color = color.green, textcolor = color.white, size = size.tiny)

float entRef = na(strategy.position_avg_price) ? entP : strategy.position_avg_price
float slAfterTp1 = beAfter ? entRef : slP

if not tp1Done
    strategy.exit("TP1 L", from_entry = "Long", qty_percent = tp1Pct, limit = tp1P, stop = slP, alert_message = f_msg(slAfterTp1, tp2P))
    strategy.exit("TP1 S", from_entry = "Short", qty_percent = tp1Pct, limit = tp1P, stop = slP, alert_message = f_msg(slAfterTp1, tp2P))
strategy.exit("TP2 L", from_entry = "Long", limit = tp2P, stop = slP, alert_message = f_msg(na, na))
strategy.exit("TP2 S", from_entry = "Short", limit = tp2P, stop = slP, alert_message = f_msg(na, na))

timeUp = maxBars > 0 and not na(entryBar) and bar_index - entryBar >= maxBars
if strategy.position_size != 0 and barstate.isconfirmed and (timeUp or dayLossHit)
    strategy.close_all(comment = dayLossHit ? "Límite diario" : "Tiempo", alert_message = f_msg(na, na))

// ───────────────────────────── Gráfico ─────────────────────────────
plot(vwapD, "VWAP diario", color = color.yellow, linewidth = 2)
plot(vwapNY, "VWAP Nueva York", color = color.rgb(0, 170, 255), linewidth = 3, style = plot.style_linebr)
plot(useBand ? dUp : na, "Banda +1 VWAP", color = color.new(color.yellow, 60))
plot(useBand ? dDn : na, "Banda -1 VWAP", color = color.new(color.yellow, 60))
posDir = math.sign(strategy.position_size)
plot(posDir != 0 ? slP : na, "Stop", color = color.red, style = plot.style_linebr, linewidth = 2)
plot(posDir != 0 and not tp1Done ? tp1P : na, "TP1", color = color.lime, style = plot.style_linebr)
plot(posDir != 0 ? tp2P : na, "TP2", color = color.green, style = plot.style_linebr)

var array<line>  ls = array.new<line>()
var array<label> lb = array.new<label>()
var table tb = table.new(position.top_right, 1, 4)
if barstate.islast
    for l in ls
        line.delete(l)
    array.clear(ls)
    for x in lb
        label.delete(x)
    array.clear(lb)
    if showLv and array.size(cand) > 0
        for i = 0 to array.size(cand) - 1
            float p = array.get(cand, i)
            string nm = array.get(candN, i)
            if nm != "VWAP diario" and nm != "VWAP NY"
                int mi = array.indexof(mTxt, nm)
                string typ = mi >= 0 ? array.get(mTyp, mi) : (p > close ? "R" : "S")
                color col = typ == "R" ? color.red : typ == "S" ? color.green : color.yellow
                array.push(ls, line.new(bar_index - 1, p, bar_index, p, extend = extend.both, color = color.new(col, 30), width = 1, style = typ == "I" ? line.style_dashed : line.style_solid))
                array.push(lb, label.new(bar_index + 3, p, nm + "  " + str.tostring(p, format.mintick), style = label.style_label_lower_left, color = color.new(col, 100), textcolor = col, size = size.small))

    string manda = na(vwapNY) ? "Antes de las 9:30 NY: manda el VWAP diario (" + (close > vwapD ? "compradores" : "vendedores") + ")" : aboveBoth ? "MANDAN LOS COMPRADORES: solo compras en el VWAP NY" : belowBoth ? "MANDAN LOS VENDEDORES: solo ventas en el VWAP NY" : magnetUp ? "ENTRE VWAPs: imán arriba, VWAP diario " + str.tostring(vwapD, format.mintick) : "ENTRE VWAPs: imán abajo, VWAP diario " + str.tostring(vwapD, format.mintick)
    color mcol = na(vwapNY) ? color.new(color.gray, 30) : aboveBoth ? color.new(color.green, 20) : belowBoth ? color.new(color.red, 20) : color.new(color.orange, 20)
    table.cell(tb, 0, 0, assetName + " · " + syminfo.ticker + " · " + str.tostring(array.size(cand)) + " niveles", text_color = color.white, bgcolor = color.new(color.blue, 20), text_size = size.small)
    table.cell(tb, 0, 1, manda, text_color = color.white, bgcolor = mcol, text_size = size.small)
    string posTxt = posDir > 0 ? "✅ COMPRA EN CURSO" : posDir < 0 ? "✅ VENTA EN CURSO" : "Sin posición"
    if posDir != 0
        posTxt += " · SL " + str.tostring(slP, format.mintick) + (tp1Done ? " (en entrada) · TP2 " : " · TP1 " + str.tostring(tp1P, format.mintick) + " · TP2 ") + str.tostring(tp2P, format.mintick)
    table.cell(tb, 0, 2, posTxt, text_color = color.white, bgcolor = posDir != 0 ? color.new(color.green, 10) : color.new(color.gray, 40), text_size = size.small)
    table.cell(tb, 0, 3, "Hoy: " + str.tostring(entriesToday) + "/" + str.tostring(maxPerDay) + " entradas · última: " + lastTxt + (dayLossHit ? " · LÍMITE DIARIO" : ""), text_color = color.white, bgcolor = color.new(color.gray, 30), text_size = size.small)
