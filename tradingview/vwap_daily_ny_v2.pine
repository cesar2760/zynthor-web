//@version=5
strategy("Estrategia VWAP diario + VWAP NY v2", overlay=true, default_qty_type=strategy.fixed, default_qty_value=2,
     commission_type=strategy.commission.cash_per_contract, commission_value=0.62, slippage=1, pyramiding=0,
     initial_capital=50000, max_bars_back=500, max_lines_count=500, max_labels_count=500, max_boxes_count=300)

// ───────── Gestión de riesgo (prueba de fondeo) ─────────
qty      = input.int(2, "Contratos", minval=1, maxval=6, group="Riesgo")
rrTP     = input.float(2.0, "Take profit en R (riesgo)", minval=0.5, step=0.25, group="Riesgo")
beAt     = input.float(1.0, "Mover stop a la entrada al llegar a X R (0 = no)", minval=0, step=0.25, group="Riesgo")
bePts    = input.float(0, "O mover stop a la entrada al ganar X puntos (0 = usar R)", minval=0, step=1, group="Riesgo")
atrBuf   = input.float(0.3, "Margen del stop detrás de la mecha (x ATR 14)", minval=0, step=0.1, group="Riesgo")
maxRiskPts = input.float(60, "Riesgo máximo por operación (puntos). Si el stop queda más lejos, no entra", minval=1, group="Riesgo")
sizeOn   = input.bool(false, "Ajustar contratos al riesgo (riesgo fijo en USD)", group="Riesgo")
riskUSD  = input.float(240, "Riesgo por operación en USD (con el ajuste activado)", minval=10, group="Riesgo")
maxPts2  = input.float(120, "Stop máximo en puntos con el ajuste activado", minval=1, group="Riesgo")
maxDayLoss = input.float(500, "Pérdida máxima del día (USD): deja de operar", minval=50, group="Riesgo")
maxTrades  = input.int(4, "Máximo de operaciones por día", minval=1, group="Riesgo")

exitMode = input.string("Parciales + trailing", "Modo de salida", options=["TP fijo", "Parciales + trailing"], group="Salida")
tp1R     = input.float(1.0, "Parcial 1 en R (1/3 de la posición)", minval=0.5, step=0.25, group="Salida")
tp2R     = input.float(2.0, "Parcial 2 en R (1/3 de la posición)", minval=0.5, step=0.25, group="Salida")
trailAct = input.float(2.0, "El último tercio: activar trailing al llegar a X R", minval=0.5, step=0.25, group="Salida")
trailAtr = input.float(1.5, "Distancia del trailing (x ATR 14)", minval=0.25, step=0.25, group="Salida")

// ───────── Horarios (hora de Nueva York) ─────────
sess     = input.session("0935-1145", "Horario para abrir operaciones", group="Horario")
flatTime = input.session("1550-1600", "Cerrar todo en este horario", group="Horario")
newsOn   = input.bool(true, "Pausa por datos macro", group="Horario")
news1    = input.session("0825-0840", "Pausa 1 (datos de las 8:30)", group="Horario")
news2    = input.session("0955-1010", "Pausa 2 (datos de las 10:00)", group="Horario")
news3    = input.session("1355-1415", "Pausa 3 (Fed 14:00, si hay)", group="Horario")

// ───────── Señal ─────────
wickMin  = input.float(30, "Mecha mínima de la vela de confirmación (% de la vela)", minval=0, maxval=90, group="Señal") / 100
useMagnet = input.bool(true, "Operar también entre VWAPs (objetivo: VWAP diario)", group="Señal")
useDaily  = input.bool(true, "Más entradas: retroceso al VWAP diario (con tendencia)", group="Señal")
useDelta  = input.bool(false, "Filtro de delta: entrar solo a favor de la presión de las últimas velas", group="Filtros extra")
deltaN    = input.int(6, "Velas para medir la presión (delta)", minval=2, group="Filtros extra")
useTrend  = input.bool(false, "Filtro de línea de tendencia: compras solo con la línea verde, ventas solo con la roja", group="Filtros extra")
useLv     = input.bool(false, "Filtro de niveles (solo en vivo): no entrar si hay un nivel contrario antes del TP1", group="Filtros extra")
lvTxt     = input.text_area("", "Niveles del informe: precio|tipo|texto ; ...  (R resistencia, S soporte, I imán)", group="Filtros extra")
preNY     = input.bool(false, "Antes de las 9:30: operar solo con el VWAP diario (usar con horario desde 0830)", group="Señal")
useBand   = input.bool(true, "Más entradas: retroceso a la banda ±1 del VWAP diario (tendencia fuerte)", group="Señal")
useEma    = input.bool(false, "Más entradas: días de tendencia sin retroceso al VWAP (rechazo en la media móvil)", group="Señal")
emaLen    = input.int(20, "Media móvil para los días de tendencia (velas)", minval=5, group="Señal")

// ───────── Mensajes para el puente (TradersPost / PickMyTrade / CrossTrade) ─────────
// Revisá el formato exacto en la documentación de tu puente. {E}=entrada {S}=stop {T}=take profit {Q}=contratos
showViz  = input.bool(true, "Dibujar cada operación (caja, entrada, stop, TP y resultado)", group="Visual")
showTab  = input.bool(true, "Cuadro de estado (abajo a la derecha)", group="Visual")
showTrd  = input.bool(true, "Línea de tendencia (verde = alcista, roja = bajista)", group="Visual")
trF      = input.float(3.0, "Línea de tendencia: distancia (× ATR). Más alto = cambia menos", minval=0.5, step=0.25, group="Visual")
trLen    = input.int(10, "Línea de tendencia: velas del ATR", minval=2, group="Visual")
msgBuy  = input.text_area("🟢 COMPRA {Q} MNQ · entrada {E} · STOP {S} ({SK} ticks) · TP1 {T1} ({TK} ticks)", "Mensaje de COMPRA", group="Alertas")
msgSell = input.text_area("🔴 VENTA {Q} MNQ · entrada {E} · STOP {S} ({SK} ticks) · TP1 {T1} ({TK} ticks)", "Mensaje de VENTA", group="Alertas")
msgExit = input.text_area("⏹ CERRAR TODO (fin del día o límite diario)", "Mensaje de CIERRE", group="Alertas")

inS(s) => not na(time(timeframe.period, s, "America/New_York"))

// VWAP diario (desde las 18:00 ET) y VWAP Nueva York (desde las 9:30 ET)
[vwapD, bandUp, bandDn] = ta.vwap(hlc3, timeframe.change("D"), 1.0)
nyH  = hour(time, "America/New_York")
nyM  = minute(time, "America/New_York")
nyH1 = hour(time[1], "America/New_York")
nyM1 = minute(time[1], "America/New_York")
nyOpen = (nyH == 9 and nyM >= 30 or nyH > 9) and (nyH1 < 9 or (nyH1 == 9 and nyM1 < 30)) and nyH < 16
var float npv = na
var float nvv = na
if timeframe.change("D")
    npv := na
    nvv := na
if nyOpen
    npv := hlc3 * volume
    nvv := volume
else if not na(npv)
    npv += hlc3 * volume
    nvv += volume
vwapNY = nvv > 0 ? npv / nvv : na
plot(vwapD, "VWAP diario", color=color.yellow, linewidth=2)
plot(vwapNY, "VWAP NY", color=color.rgb(0, 170, 255), linewidth=3, style=plot.style_linebr)

atrV = ta.atr(14)
[stV, stD] = ta.supertrend(trF, trLen)
upT = stD < 0
pTr = plot(showTrd ? stV : na, "Línea de tendencia", color=upT ? color.rgb(38, 214, 170) : color.rgb(220, 50, 70), linewidth=2, style=plot.style_linebr)
pPx = plot(showTrd ? close : na, "Precio (relleno)", color=na, display=display.none)
fill(pTr, pPx, color=upT ? color.new(color.rgb(38, 214, 170), 85) : color.new(color.rgb(220, 50, 70), 85), title="Relleno de tendencia")
plotshape(showTrd and stD != stD[1] and upT ? stV : na, "Cambio a alcista", style=shape.circle, location=location.absolute, color=color.rgb(38, 214, 170), size=size.small)
plotshape(showTrd and stD != stD[1] and not upT ? stV : na, "Cambio a bajista", style=shape.circle, location=location.absolute, color=color.rgb(220, 50, 70), size=size.small)
dv = close > open ? volume : close < open ? -volume : 0.0
dSum = math.sum(dv, deltaN)
var aLv = array.new_float()
var aLt = array.new_string()
if barstate.isfirst and str.length(lvTxt) > 0
    items = str.split(str.replace_all(lvTxt, "\n", ";"), ";")
    for k = 0 to array.size(items) - 1
        pp = str.split(array.get(items, k), "|")
        if array.size(pp) >= 2
            lvV = str.tonumber(str.replace_all(array.get(pp, 0), " ", ""))
            if not na(lvV)
                array.push(aLv, lvV)
                array.push(aLt, str.upper(str.replace_all(array.get(pp, 1), " ", "")))
// true si hay un nivel contrario (R para compras / S para ventas) entre la entrada y el objetivo
blocked(bool isBuy, float e, float t) =>
    bool bl = false
    if array.size(aLv) > 0
        for j = 0 to array.size(aLv) - 1
            lv = array.get(aLv, j)
            ty = array.get(aLt, j)
            if isBuy and (ty == "R" or ty == "I") and lv > e and lv < t
                bl := true
            if not isBuy and (ty == "S" or ty == "I") and lv < e and lv > t
                bl := true
    bl
rng  = high - low
aboveBoth = not na(vwapNY) and close > vwapD and close > vwapNY
belowBoth = not na(vwapNY) and close < vwapD and close < vwapNY
magnetUp  = useMagnet and not na(vwapNY) and close > vwapNY and close < vwapD
magnetDn  = useMagnet and not na(vwapNY) and close < vwapNY and close > vwapD

okL = close > open and rng > 0 and (math.min(open, close) - low) >= wickMin * rng
okS = close < open and rng > 0 and (high - math.max(open, close)) >= wickMin * rng
reclL(x) => not na(x) and low <= x and close > x
reclS(x) => not na(x) and high >= x and close < x
emaV = ta.ema(close, emaLen)
plot(useEma ? emaV : na, "Media de tendencia", color=color.new(color.orange, 30))
// Día de tendencia: la media ya está lejos del VWAP NY y el precio la rechaza
emaS = useEma and belowBoth and emaV < vwapNY and okS and reclS(emaV)
emaL = useEma and aboveBoth and emaV > vwapNY and okL and reclL(emaV)
pre = preNY and na(vwapNY)
longPre  = pre and okL and close > vwapD and (reclL(vwapD) or (useBand and close[1] > bandUp[1] and reclL(bandUp)))
shortPre = pre and okS and close < vwapD and (reclS(vwapD) or (useBand and close[1] < bandDn[1] and reclS(bandDn)))
longSig  = longPre or emaL or okL and (((aboveBoth or magnetUp) and reclL(vwapNY)) or (useDaily and aboveBoth and reclL(vwapD)) or (useBand and aboveBoth and close[1] > bandUp[1] and reclL(bandUp)))
shortSig = shortPre or emaS or okS and (((belowBoth or magnetDn) and reclS(vwapNY)) or (useDaily and belowBoth and reclS(vwapD)) or (useBand and belowBoth and close[1] < bandDn[1] and reclS(bandDn)))
plot(useBand ? bandUp : na, "Banda +1", color=color.new(color.red, 50))
plot(useBand ? bandDn : na, "Banda -1", color=color.new(color.green, 50))

// ───────── Límites diarios ─────────
var float dayStartEq = strategy.equity
var int tradesToday = 0
if timeframe.change("D")
    dayStartEq := strategy.equity
    tradesToday := 0
dayPnL  = strategy.equity - dayStartEq
dayStop = dayPnL <= -maxDayLoss
canTrade = inS(sess) and not (newsOn and (inS(news1) or inS(news2) or inS(news3))) and not dayStop and tradesToday < maxTrades and strategy.position_size == 0

fillMsg(m, e, s, t, q) =>
    rk = math.round(math.abs(e - s) / syminfo.mintick)
    tk = math.round(tp1R * math.abs(e - s) / syminfo.mintick)
    t1 = e + tp1R * (e - s)
    o = str.replace_all(m, "{SK}", str.tostring(rk))
    o := str.replace_all(o, "{TK}", str.tostring(tk))
    o := str.replace_all(o, "{T1}", str.tostring(t1, "#.##"))
    o := str.replace_all(o, "{E}", str.tostring(e, "#.##"))
    o := str.replace_all(o, "{S}", str.tostring(s, "#.##"))
    o := str.replace_all(o, "{T}", str.tostring(t, "#.##"))
    o := str.replace_all(o, "{Q}", str.tostring(q))
    o

var float slP = na
var float tpP = na
var float enP = na
var bool  beDone = false
var bool  trDone = false
var float slP0 = na
var int   qNow = 0

if canTrade and longSig
    sl = low - atrBuf * atrV
    risk = close - sl
    tp = magnetUp ? math.min(close + rrTP * risk, vwapD) : close + rrTP * risk
    t1chk = close + tp1R * risk
    okF = (not useTrend or upT) and (not useDelta or dSum > 0) and (not useLv or not blocked(true, close, t1chk))
    nQ = risk > 0 ? (sizeOn ? int(math.min(qty, math.floor(riskUSD / (risk * syminfo.pointvalue)))) : qty) : 0
    okR = sizeOn ? (nQ >= 1 and risk <= maxPts2) : risk <= maxRiskPts
    if okF and risk > 0 and okR and (tp - close) >= risk
        strategy.entry("L", strategy.long, nQ, alert_message=fillMsg(msgBuy, close, sl, tp, nQ))
        qNow := nQ
        slP := sl
        slP0 := sl
        tpP := tp
        enP := close
        beDone := false
        trDone := false
        tradesToday += 1

if canTrade and shortSig
    sl = high + atrBuf * atrV
    risk = sl - close
    tp = magnetDn ? math.max(close - rrTP * risk, vwapD) : close - rrTP * risk
    t1chk = close - tp1R * risk
    okF = (not useTrend or not upT) and (not useDelta or dSum < 0) and (not useLv or not blocked(false, close, t1chk))
    nQ = risk > 0 ? (sizeOn ? int(math.min(qty, math.floor(riskUSD / (risk * syminfo.pointvalue)))) : qty) : 0
    okR = sizeOn ? (nQ >= 1 and risk <= maxPts2) : risk <= maxRiskPts
    if okF and risk > 0 and okR and (close - tp) >= risk
        strategy.entry("S", strategy.short, nQ, alert_message=fillMsg(msgSell, close, sl, tp, nQ))
        qNow := nQ
        slP := sl
        slP0 := sl
        tpP := tp
        enP := close
        beDone := false
        trDone := false
        tradesToday += 1

// Stop a breakeven al llegar a X R
if (beAt > 0 or bePts > 0) and not beDone and strategy.position_size != 0 and not na(enP)
    r = math.abs(enP - slP)
    dist = bePts > 0 ? bePts : beAt * r
    if strategy.position_size > 0 and high >= enP + dist
        slP := enP
        beDone := true
    if strategy.position_size < 0 and low <= enP - dist
        slP := enP
        beDone := true

if beDone and not beDone[1] and strategy.position_size != 0 and (bePts > 0 or beAt != tp1R)
    alert("🔒 BREAKEVEN · " + syminfo.ticker + ": mové el STOP a tu precio de entrada (≈ " + str.tostring(enP, "#.##") + ").", alert.freq_once_per_bar)
q1 = math.max(1, math.floor(qNow / 3))
q2 = math.max(0, math.floor(qNow / 3))
q3 = qNow - q1 - q2
pos = math.abs(strategy.position_size)
rr  = na(enP) ? na : math.abs(enP - slP)
isL = strategy.position_size > 0
dir = isL ? 1 : -1
eid = isL ? "L" : "S"
lossMsg = beDone ? "➖ BREAKEVEN · " + syminfo.ticker + ": salió en la entrada. Operación terminada, sin pérdida." : "❌ STOP TOCADO · " + syminfo.ticker + ": operación terminada. Si tu stop no se ejecutó, cerrá a mercado."
if pos > 0 and exitMode == "Parciales + trailing" and not trDone and not na(enP) and q3 > 0 and pos <= q3
    rT = math.abs(enP - slP0)
    if (isL and high >= enP + trailAct * rT) or (not isL and low <= enP - trailAct * rT)
        trDone := true
        alert("🏃 TRAILING ACTIVO · " + syminfo.ticker + ": el último contrato ganó " + str.tostring(trailAct, "#.##") + "R. Llevá el stop a " + str.tostring(trailAtr * atrV, "#") + " puntos del " + (isL ? "máximo" : "mínimo") + " y movelo a medida que el precio avanza.", alert.freq_once_per_bar)
if pos > 0 and exitMode == "TP fijo"
    strategy.exit("X" + eid, eid, stop=slP, limit=tpP, alert_profit="✅ TP TOCADO · " + syminfo.ticker + ": cerrá todo. Operación terminada.", alert_loss=lossMsg)
if pos > 0 and exitMode == "Parciales + trailing" and not na(rr)
    r0 = math.abs(enP - (isL ? slP0 : slP0))
    t1 = enP + dir * tp1R * r0
    t2 = enP + dir * tp2R * r0
    trPts = math.round(trailAct * r0 / syminfo.mintick)
    trOff = math.round(trailAtr * atrV / syminfo.mintick)
    if pos == qNow and q1 > 0
        strategy.exit("P1" + eid, eid, qty=q1, stop=slP, limit=t1, alert_profit=(qNow > 1 ? "✅ TP1 TOCADO · " + syminfo.ticker + " en " + str.tostring(t1, "#.##") + ": cerrá 1 contrato y MOVÉ EL STOP del otro a tu entrada (≈ " + str.tostring(enP, "#.##") + ")." : "✅ TP1 TOCADO · " + syminfo.ticker + " en " + str.tostring(t1, "#.##") + ": cerrá todo. Operación terminada."), alert_loss=lossMsg)
    if pos >= q2 + q3 and q2 > 0
        strategy.exit("P2" + eid, eid, qty=q2, stop=slP, limit=t2, alert_profit="✅ TP2 TOCADO · " + syminfo.ticker + ": cerrá 1 contrato más.", alert_loss=lossMsg)
    if q3 > 0
        strategy.exit("P3" + eid, eid, qty=q3, stop=slP, trail_points=trPts, trail_offset=trOff, alert_trailing="🏁 TRAILING · " + syminfo.ticker + ": el precio volvió " + str.tostring(trailAtr * atrV, "#") + " puntos desde el extremo. Cerrá el contrato que queda (en ganancia).", alert_loss=lossMsg)

// Cierre obligatorio al final del día o si se alcanza la pérdida diaria
if strategy.position_size != 0 and (inS(flatTime) or dayStop)
    strategy.close_all(comment="Cierre de día", alert_message=msgExit)

plot(not showViz and strategy.position_size != 0 ? slP : na, "Stop", color=color.red, style=plot.style_linebr)
plot(not showViz and strategy.position_size != 0 ? tpP : na, "Take profit", color=color.green, style=plot.style_linebr)

// ───────── Dibujo de cada operación ─────────
var line  vE  = na
var line  vS  = na
var line  vT1 = na
var line  vT2 = na
var box   vBR = na
var box   vBG = na
var label vLE = na
var label vLS = na
var label vL1 = na
var label vL2 = na
var float vT1p = na
var float vT2p = na
inPos  = strategy.position_size != 0
newPos = inPos and not inPos[1]
if showViz and newPos
    ep = strategy.position_avg_price
    d  = strategy.position_size > 0 ? 1 : -1
    r0v = math.abs(ep - slP0)
    vT1p := ep + d * tp1R * r0v
    vT2p := exitMode == "TP fijo" ? tpP : ep + d * trailAct * r0v
    nC = math.abs(strategy.position_size)
    vBR := box.new(bar_index, math.max(ep, slP0), bar_index + 3, math.min(ep, slP0), border_color=color.new(color.red, 50), bgcolor=color.new(color.red, 82))
    vBG := box.new(bar_index, math.max(ep, vT2p), bar_index + 3, math.min(ep, vT2p), border_color=color.new(color.green, 50), bgcolor=color.new(color.green, 85))
    vE  := line.new(bar_index, ep, bar_index + 3, ep, color=color.yellow, width=2)
    vS  := line.new(bar_index, slP0, bar_index + 3, slP0, color=color.red, width=2)
    vT1 := line.new(bar_index, vT1p, bar_index + 3, vT1p, color=color.lime, width=1, style=line.style_dashed)
    vT2 := line.new(bar_index, vT2p, bar_index + 3, vT2p, color=color.green, width=2)
    label.new(bar_index, d > 0 ? low : high, (d > 0 ? "▲ COMPRA " : "▼ VENTA ") + str.tostring(nC) + " MNQ", style=d > 0 ? label.style_label_up : label.style_label_down, color=d > 0 ? color.new(color.green, 0) : color.new(color.red, 0), textcolor=color.white, size=size.normal)
    vLE := label.new(bar_index + 3, ep, "ENTRADA " + str.tostring(ep, "#.##"), style=label.style_label_left, color=color.new(color.yellow, 0), textcolor=color.black, size=size.small)
    vLS := label.new(bar_index + 3, slP0, "STOP " + str.tostring(slP0, "#.##") + "  (−" + str.tostring(math.round(r0v)) + " pts)", style=label.style_label_left, color=color.new(color.red, 0), textcolor=color.white, size=size.small)
    vL1 := label.new(bar_index + 3, vT1p, "TP1 " + str.tostring(vT1p, "#.##") + (nC > 1 ? "  (cerrar 1)" : "  (cerrar todo)"), style=label.style_label_left, color=color.new(color.lime, 0), textcolor=color.black, size=size.small)
    vL2 := label.new(bar_index + 3, vT2p, (exitMode == "TP fijo" ? "TP " : "TP2 / trailing ") + str.tostring(vT2p, "#.##"), style=label.style_label_left, color=color.new(color.green, 0), textcolor=color.white, size=size.small)
if showViz and inPos and not newPos and not na(vE)
    x2 = bar_index + 3
    line.set_x2(vE, x2)
    line.set_x2(vS, x2)
    line.set_x2(vT1, x2)
    line.set_x2(vT2, x2)
    box.set_right(vBR, x2)
    box.set_right(vBG, x2)
    // Si el stop se movió a la entrada (breakeven), la línea roja lo muestra
    line.set_y1(vS, slP)
    line.set_y2(vS, slP)
    label.set_x(vLE, x2)
    label.set_x(vLS, x2)
    label.set_x(vL1, x2)
    label.set_x(vL2, x2)
    label.set_y(vLS, slP)
    label.set_text(vLS, (beDone ? "STOP en la entrada " : "STOP ") + str.tostring(slP, "#.##"))
// Al cerrar, las líneas quedan cortadas en la última vela y se borran las etiquetas de la derecha
if showViz and not inPos and inPos[1] and not na(vE)
    label.delete(vLE)
    label.delete(vLS)
    label.delete(vL1)
    label.delete(vL2)
    line.set_x2(vE, bar_index)
    line.set_x2(vS, bar_index)
    line.set_x2(vT1, bar_index)
    line.set_x2(vT2, bar_index)
    box.set_right(vBR, bar_index)
    box.set_right(vBG, bar_index)

// Resultado de cada salida (TP1, trailing, stop, breakeven o cierre del día)
ctN = strategy.closedtrades
ctP = nz(ctN[1])
if showViz and ctN > ctP
    string txt = ""
    float pxT = na
    float pnl = 0.0
    for k = ctP to ctN - 1
        idX = strategy.closedtrades.exit_id(k)
        pr  = strategy.closedtrades.profit(k)
        pxT := strategy.closedtrades.exit_price(k)
        pnl += pr
        nmX = pr > 0.5 ? (str.startswith(idX, "P1") ? "✅ TP1" : str.startswith(idX, "P2") ? "✅ TP2" : str.startswith(idX, "P3") ? "✅ Trailing" : str.startswith(idX, "X") ? "✅ TP" : "✅ Cierre del día") : pr < -0.5 ? (str.startswith(idX, "P") or str.startswith(idX, "X") ? "❌ Stop" : "❌ Cierre del día") : "➖ Breakeven"
        txt := txt == "" ? nmX : txt + " · " + nmX
    label.new(bar_index, pxT, txt + "  " + (pnl >= 0 ? "+" : "") + str.tostring(pnl, "#") + " USD", style=label.style_label_left, color=pnl > 0.5 ? color.new(color.green, 10) : pnl < -0.5 ? color.new(color.red, 10) : color.new(color.gray, 20), textcolor=color.white, size=size.small)

// ───────── Cuadro de estado ─────────
var table tbS = table.new(position.bottom_right, 1, 3, border_width=1)
if showTab and barstate.islast
    manda = na(vwapNY) ? "Antes de las 9:30: manda el VWAP diario" : aboveBoth ? "Mandan los COMPRADORES: solo compras" : belowBoth ? "Mandan los VENDEDORES: solo ventas" : "Entre los VWAP: objetivo el VWAP diario"
    mcol  = na(vwapNY) ? color.new(color.gray, 20) : aboveBoth ? color.new(color.green, 15) : belowBoth ? color.new(color.red, 15) : color.new(color.orange, 15)
    table.cell(tbS, 0, 0, manda, text_color=color.white, bgcolor=mcol, text_size=size.small)
    est = inPos ? ((strategy.position_size > 0 ? "🟢 EN COMPRA " : "🔴 EN VENTA ") + str.tostring(math.abs(strategy.position_size)) + " MNQ · entrada " + str.tostring(strategy.position_avg_price, "#.##") + " · stop " + str.tostring(slP, "#.##") + " · P&L " + str.tostring(strategy.openprofit, "#") + " USD") : canTrade ? "⏳ Buscando entrada (" + str.tostring(maxTrades - tradesToday) + " restantes hoy)" : dayStop ? "⛔ Freno diario alcanzado: no operar más hoy" : "💤 Fuera de horario o pausa por noticias"
    table.cell(tbS, 0, 1, est, text_color=color.white, bgcolor=inPos ? color.new(color.blue, 15) : color.new(color.gray, 30), text_size=size.small)
    table.cell(tbS, 0, 2, "Hoy: " + str.tostring(tradesToday) + " operaciones · resultado " + (dayPnL >= 0 ? "+" : "") + str.tostring(dayPnL, "#") + " USD · freno −" + str.tostring(maxDayLoss, "#") + " USD", text_color=color.white, bgcolor=dayPnL >= 0 ? color.new(color.teal, 30) : color.new(color.maroon, 30), text_size=size.small)
